{
  "name": "@nitrimandylis/flick",
  "version": "0.1.1",
  "description": "Search a film or a show, pick a torrent, watch it now in a full-screen terminal UI. Or watch together, in sync, from two places.",
  "keywords": [
    "torrent",
    "streaming",
    "tui",
    "watch-party",
    "cli",
    "ink"
  ],
  "license": "MIT",
  "author": "Nick Trimandylis",
  "homepage": "https://github.com/nitrimandylis/flick#readme",
  "type": "module",
  "bin": {
    "flick": "dist/flick.js"
  },
  "files": [
    "dist",
    "room",
    "man",
    "README.md",
    "LICENSE"
  ],
  "man": [
    "man/flick.1"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitrimandylis/flick.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/cli.tsx --target=node --format=esm --packages=external --outfile dist/flick.js",
    "prepack": "bun run build",
    "dev": "bun src/cli.tsx",
    "test": "bun test src",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "cloudflared": "^0.7.3",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "webtorrent": "^3.0.21",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "cloudflared",
    "node-datachannel",
    "utp-native"
  ]
}
